# Local material and credentials never belong in the public repository.
/private/
/.git-public/
/.agents/
/.codex/
/.aws/
.env
.env.*
*.pem
*.key

# Personal projects and photos are ignored by default.
*.json
!examples/house.json
!tests/fixtures/*.json
*.jpg
*.JPG
*.JPEG
*.HEIC
*.PNG
*.jpeg
*.heic
*.raw
*.dng
*.png
!assets/**/*.png
!assets/*.png
!examples/house-day.png
!examples/house-night.png
!examples/layout.png
*.mp4
*.mov
*.gif
*.zip
*.tar.gz
*.bundle

# Python, generated media and packaging output.
.venv*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
/build/
/dist/
/renders/
/videos/
*.alignment.png
